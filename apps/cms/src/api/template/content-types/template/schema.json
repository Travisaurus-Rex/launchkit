{
  "kind": "collectionType",
  "collectionName": "templates",
  "info": {
    "singularName": "template",
    "pluralName": "templates",
    "displayName": "Template"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "fullPageScreenshot": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "templateCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "templates"
    },
    "brand": {
      "type": "component",
      "component": "template.brand",
      "repeatable": false
    },
    "hero": {
      "type": "component",
      "component": "template.hero",
      "repeatable": false
    },
    "features": {
      "type": "component",
      "component": "template.feature",
      "repeatable": true
    },
    "design": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "nova",
        "atelier",
        "local"
      ]
    },
    "projects": {
      "type": "component",
      "component": "template.project",
      "repeatable": true
    },
    "menuItems": {
      "type": "component",
      "component": "template.menu-item",
      "repeatable": true
    },
    "businessInfo": {
      "type": "component",
      "component": "template.business-info",
      "repeatable": false
    },
    "galleryImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
